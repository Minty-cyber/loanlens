// LoanLens measures
// ----------------------------------------------------------------------------
// Exported from powerbi/LoanLens.pbix with INFO.VIEW.MEASURES() and
// INFO.VIEW.TABLES(), so names and expressions match the report exactly.
// Definitions and caveats are in docs/LoanLens_KPI_Workbook.xlsx (KPI
// Definitions sheet), and the expected values are on its Reconciliation sheet.
//
// Tables: load every parquet file in data/exports/.
//
// Relationships (many-to-one, single direction, dimension filters fact):
//   fact_loans[date_key]                -> dim_date[date_key]
//   fact_loans[grade_key]               -> dim_grade[grade_key]
//   fact_loans[purpose_key]             -> dim_purpose[purpose_key]
//   fact_loans[term_key]                -> dim_term[term_key]
//   fact_loans[home_ownership_key]      -> dim_home_ownership[home_ownership_key]
//   fact_loans[verification_status_key] -> dim_verification[verification_status_key]
//   fact_loans[dti_band_key]            -> dim_dti_band[dti_band_key]
//   fact_loans[income_band_key]         -> dim_income_band[income_band_key]
//
// data_quality_results is loaded on its own, with no relationships.
//
// Sort by column: dim_dti_band[dti_band] and dim_income_band[income_band] by
// their sort_order column.
//
// No format strings are set on the measures; number formats are set on the
// visuals.
// ----------------------------------------------------------------------------


// ---- What-if parameters (Modeling > New parameter > Numeric range) ---------
// Each creates a table with a slicer column and a value measure.

// Default Shock: percentage points added to every grade's default rate.
// 0 to 5 points in steps of 0.5.
Default Shock = GENERATESERIES ( 0, 0.05, 0.005 )

// Measure in table 'Default Shock'.
Default Shock Value =
SELECTEDVALUE ( 'Default Shock'[Default Shock], 0 )

// LGD: loss given default. ASSUMPTION: the data has no recoveries, so this is
// an input, not a result. 30% to 90% in steps of 5%. 45% when nothing is selected.
LGD = GENERATESERIES ( 0.3, 0.9, 0.05 )

// Measure in table 'LGD'.
LGD Value =
SELECTEDVALUE ( 'LGD'[LGD], 0.45 )


// ---- Core (table _Measures) -------------------------------------------------

// Original amount applied for, not an outstanding balance.
Total Loan Amount =
SUM ( fact_loans[requested_amount] )

// One row is one loan.
Loan Count =
COUNTROWS ( fact_loans )

Average Loan Amount =
DIVIDE ( [Total Loan Amount], [Loan Count] )

// Helper. default_flag is 1 for Charged Off, 0 for Fully Paid.
Default Count =
SUM ( fact_loans[default_flag] )

// Share of loans charged off. Counts loans, not money.
Default Rate =
DIVIDE ( [Default Count], [Loan Count] )

// Returns TEXT such as "13.64%", for the card. Unweighted average.
// Being text, it cannot be used as a value in a chart.
Average Interest Rate =
FORMAT ( AVERAGE ( fact_loans[interest_rate_pct] ), "0.00" ) & "%"


// ---- Portfolio quality ------------------------------------------------------

// Exposure that defaulted, not the actual loss (no recoveries in the data).
Charged Off Loan Amount =
CALCULATE ( [Total Loan Amount], fact_loans[default_flag] = 1 )

// Share of the money, not the loans, that was charged off.
Charged-Off Amount Share =
DIVIDE ( [Charged Off Loan Amount], [Total Loan Amount] )

// Simple average, leaving out loans flagged as DTI outliers.
Average Debt To Income =
CALCULATE (
    AVERAGE ( fact_loans[debt_to_income_pct] ),
    fact_loans[is_dti_outlier] = FALSE ()
)

// The denominator ignores the Term slicer so the card still makes sense
// when a term is selected.
60-Month Loan Share =
DIVIDE (
    CALCULATE ( [Loan Count], dim_term[term_months] = 60 ),
    CALCULATE ( [Loan Count], REMOVEFILTERS ( dim_term ) )
)

// One purpose's share of total loan value.
Loan Amount Share =
DIVIDE (
    [Total Loan Amount],
    CALCULATE ( [Total Loan Amount], REMOVEFILTERS ( dim_purpose ) )
)


// ---- Card display -----------------------------------------------------------
// Return TEXT in short form ($5.59B, $1.2M, $850K) for the KPI cards.

Total Loan Amount Card =
VAR v = [Total Loan Amount]
RETURN
    IF (
        ISBLANK ( v ),
        "$0",
        SWITCH (
            TRUE (),
            v >= 1000000000, FORMAT ( v / 1000000000, "$0.00" ) & "B",
            v >= 1000000,    FORMAT ( v / 1000000,    "$0.0"  ) & "M",
            v >= 1000,       FORMAT ( v / 1000,       "$0"    ) & "K",
            FORMAT ( v, "$0" )
        )
    )

Charged Off Amount Card =
VAR v = [Charged Off Loan Amount]
RETURN
    IF (
        ISBLANK ( v ),
        "$0",
        SWITCH (
            TRUE (),
            v >= 1000000000, FORMAT ( v / 1000000000, "$0.00" ) & "B",
            v >= 1000000,    FORMAT ( v / 1000000,    "$0.0"  ) & "M",
            v >= 1000,       FORMAT ( v / 1000,       "$0"    ) & "K",
            FORMAT ( v, "$0" )
        )
    )


// ---- Stress test ------------------------------------------------------------

// Capped at 100%.
Stressed Default Rate =
MIN ( 1, [Default Rate] + [Default Shock Value] )

// Loan amount x default rate x LGD, grade by grade, then summed, so the
// total equals the sum of the grade columns. An estimate, not a forecast.
Base Expected Loss =
SUMX (
    VALUES ( dim_grade[credit_grade] ),
    [Total Loan Amount] * [Default Rate] * [LGD Value]
)

// Same as Base Expected Loss, using each grade's stressed default rate.
Stressed Expected Loss =
SUMX (
    VALUES ( dim_grade[credit_grade] ),
    [Total Loan Amount] * MIN ( 1, [Default Rate] + [Default Shock Value] ) * [LGD Value]
)

Expected Loss Increase =
[Stressed Expected Loss] - [Base Expected Loss]
